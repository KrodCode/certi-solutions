# Aplicación
HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# Protección del endpoint del agente
AGENT_RATE_LIMIT_WINDOW_MS=300000
AGENT_RATE_LIMIT_MAX=20

# Inteligencia artificial
AI_PROVIDER=provider_name
AI_MODEL=model_name
AI_API_KEY=replace_with_your_api_key

# Base de datos
DATABASE_HOST=127.0.0.1
DATABASE_PORT=1433
DATABASE_NAME=certi_solutions
DATABASE_USER=replace_with_database_user
DATABASE_PASSWORD=replace_with_database_password

# Oracle Cloud Infrastructure
OCI_REGION=replace_with_oci_region
OCI_COMPARTMENT_ID=replace_with_compartment_id
